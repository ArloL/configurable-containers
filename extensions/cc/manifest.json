{
  "manifest_version": 2,
  "name": "configurable-containers",
  "version": "0.0.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "cc@configurable-containers.test"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "tabs",
    "contextualIdentities",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "reopen-picker": {
      "suggested_key": { "default": "Ctrl+Shift+O" },
      "description": "Reopen this tab in a container"
    }
  }
}
