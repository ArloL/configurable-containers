{
  "name": "configurable-containers-e2e-spike",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "manual": "tsx harness/manual.ts",
    "package": "tsx scripts/package.ts",
    "submit": "web-ext sign --source-dir dist/cc --artifacts-dir dist --channel listed --api-key \"$WEB_EXT_API_KEY\" --api-secret \"$WEB_EXT_API_SECRET\""
  },
  "dependencies": {
    "tldts": "^6.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.1.1",
    "@types/selenium-webdriver": "^4.1.0",
    "esbuild": "^0.28.1",
    "fast-check": "^3.22.0",
    "selenium-webdriver": "^4.25.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0"
  }
}
